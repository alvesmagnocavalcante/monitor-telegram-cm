# Preencha com as credenciais do seu bot e chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Um tópico por computador. Deixe TELEGRAM_TOPIC vazio para enviar ao chat.
# Valores: Taiba, charme, Magna, acaraizinho ou wind.
TELEGRAM_TOPIC=
# Preencha o ID real de cada tópico usado. Não são IDs do grupo.
TELEGRAM_TOPIC_TAIBA_ID=
TELEGRAM_TOPIC_CHARME_ID=
TELEGRAM_TOPIC_MAGNA_ID=
TELEGRAM_TOPIC_ACARAIZINHO_ID=
TELEGRAM_TOPIC_WIND_ID=

# Monitoramento: percentuais de 0 a 100, duração Go (30s, 1m) e caminho absoluto.
CPU_LIMIT=90
RAM_LIMIT=75
DISK_LIMIT=90
MONITOR_INTERVAL=30s
DISK_PATH=C:\
